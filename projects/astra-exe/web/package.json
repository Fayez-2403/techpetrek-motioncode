{
  "name": "astra-exe",
  "private": true,
  "type": "module",
  "description": "ASTRA.EXE: the Celestial Weapon Physics Laboratory. Interactive 3D bow, projectile and fracture simulation (Three.js, React Three Fiber, Rapier).",
  "scripts": {
    "dev": "vite --port 54200",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:core": "bun scripts/test_core.ts",
    "test:browser": "bun scripts/test_browser.ts",
    "capture": "bun scripts/capture.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "^1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "@types/bun": "latest"
  }
}
