{
  "name": "kimi-k31-pro-film",
  "private": true,
  "version": "1.0.0",
  "description": "KIMI K3.1 PRO - FROM THINKING TO BUILDING. Independent TechpeTrek explainer film (not affiliated with Moonshot AI).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.ts",
    "still": "remotion still src/index.ts",
    "render:master": "remotion render src/index.ts KimiMasterFilm ../KIMI_K31_PRO_MASTER_16x9.mp4 --codec=h264 --crf=16 --audio-codec=aac --gl=angle",
    "render:reel": "remotion render src/index.ts KimiInstagramCut ../KIMI_K31_PRO_REEL_9x16.mp4 --codec=h264 --crf=17 --audio-codec=aac --gl=angle"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.538",
    "@remotion/three": "4.0.538",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.538",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.1.12",
    "@types/three": "0.186.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
