# Motion as Code: what stays off GitHub.
# Rule of thumb: code, scripts, small data (JSON/cue sheets), docs and the fonts/assets an app needs to run go in.
# Secrets, dependencies, caches, renders, recordings and third-party media stay local.

# ---------------------------------------------------------------- secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
auth.json
.vercel/
.claude/settings.local.json
**/credentials*.json
**/service-account*.json

# ---------------------------------------------------------------- dependencies, caches, build output
node_modules/
.venv/
.venv-*/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.vite/
.cache/
dist/
build/
bundle-render/
.remotion/
test-results/
.playwright-mcp/
*.log
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- renders, captures, QA frames
out/
output/
outputs/
renders/
**/reel/clips/
**/reel/clips_v1/
**/reel/wip/
**/reel/qa/
**/edit/public/clips/
**/out/seg*/

# ---------------------------------------------------------------- heavy media (regenerated by the scripts, or not ours to share)
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.m4v
*.wav
*.flac
*.aif
*.aiff
*.mp3
*.m4a
*.aac
*.ogg
*.opus
*.zip
*.7z
*.rar
*.tar
*.gz

# ...except what an app needs to run (licensed for redistribution; credited in its README)
!projects/aftercode/web/public/music/*.mp3

# reels made from the motion-studio template: source media in assets/ stays local (rights tracked in docs/asset_manifest.csv)
projects/*/assets/**
!projects/*/assets/**/
!projects/*/assets/**/.gitkeep

# third-party press images staged for a reel (Apple Newsroom etc.; listed in that reel's docs/asset_manifest.csv)
projects/apple-m6-local-ai/public/img/
# PaperPilot reel: repo icon, our screen captures of usepaperpilot.com / GitHub, and the synthetic scan (see its asset_manifest.csv)
projects/paperpilot-local-pdf/public/img/

# frame sequences extracted from videos (regenerated by the scripts; some come from stock or third-party footage)
app/public/*/frames/
projects/*/frames/
projects/*/src_video/
projects/*/dm-pack/
projects/*/cover/
projects/aftercode/assets/
projects/aftercode/web/test-assets/*.jpg
projects/aftercode/web/test-assets/*.png

# ---------------------------------------------------------------- third-party material (research, screenshots, stock, other creators' media)
**/references/
app/public/*/screens/
app/public/*/thumbs/
app/public/gh/*.jpg
data/aura*/face.json
/Assets/
kit/*.pdf

# ---------------------------------------------------------------- separate repositories (cloned or published on their own)
/OpenMontage/
/share/
tools/genjutsu/
tools/open-higgsfield-ai/
# AFTERCODE reel-only media (AI-generated faces for the capture; not part of the app or its deploy)
projects/aftercode/web/public/_reel/
/skills/

# imported skill packs stay local (they have their own sources and licences); only this repo's own skills are shared
.claude/skills/*
!.claude/skills/reel-pipeline/
!.claude/skills/motion-studio/
# ...but the prompt pack it was built from (the author's PDF and our transcriptions) stays local
# (the **/references/ rule above already covers it; kept explicit)
.claude/skills/motion-studio/references/source/

# screenshots of third-party sources used as on-screen receipts
**/public/receipts/
app/public/repos/*.jpg

