tools/claude-animation-skills/kit/vendor/
tools/claude-animation-skills/kit/.venv/
tools/claude-animation-skills/kit/models/

# binance-heist: the captured Binance report page (third-party; re-capture with web/scripts/grab_report.mjs)
projects/binance-heist/public/pages/

# unslop-reel: third-party page captures (re-capture with web/scripts/grab_pages.mjs)
projects/unslop-reel/public/pages/

# dev-journey-sajan: the user's commercial song (never commit) + its decoded copy
projects/dev-journey-sajan/audio/src/

# dev-life-aura: the user's commercial song, the stock originals (re-fetch: python scripts/fetch_stock.py) and their 60 fps proxies
projects/dev-life-aura/audio/src/
projects/dev-life-aura/assets/licensed/
projects/dev-life-aura/public/footage/

# paper-sajan: the user's commercial song copy, and the sketch shots (rebuild: python scripts/build_shots.py from dev-life-aura stock)
projects/paper-sajan/audio/src/
projects/paper-sajan/public/sketch/

# lemo-opuscar: LemoLab film-style library (its own git repo, 267 MB; code MIT, docs CC BY-NC 4.0 + film-making permission). Re-clone: git clone --depth 1 https://github.com/lemomo-ai/lemo-opuscar.git tools/lemo-opuscar
tools/lemo-opuscar/
