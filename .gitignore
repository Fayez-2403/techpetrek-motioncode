# Motion as Code: what stays off GitHub.
# Rule of thumb: code, scripts, small data (JSON/cue sheets), docs and the fonts/assets an app needs to run go in.
# Secrets, dependencies, caches, renders, recordings and third-party media stay local.

# ---------------------------------------------------------------- secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
auth.json
.vercel/
.claude/settings.local.json
**/credentials*.json
**/service-account*.json

# ---------------------------------------------------------------- dependencies, caches, build output
node_modules/
.venv/
.venv-*/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.vite/
.cache/
dist/
build/
bundle-render/
.remotion/
test-results/
.playwright-mcp/
*.log
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- renders, captures, QA frames
out/
output/
outputs/
renders/
**/reel/clips/
**/reel/clips_v1/
**/reel/wip/
**/reel/qa/
**/edit/public/clips/
**/out/seg*/

# ---------------------------------------------------------------- heavy media (regenerated by the scripts, or not ours to share)
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.m4v
*.wav
*.flac
*.aif
*.aiff
*.mp3
*.m4a
*.aac
*.ogg
*.opus
*.zip
*.7z
*.rar
*.tar
*.gz

# ...except what an app needs to run (licensed for redistribution; credited in its README)
!projects/aftercode/web/public/music/*.mp3

# frame sequences extracted from videos (regenerated by the scripts; some come from stock or third-party footage)
app/public/*/frames/
projects/*/frames/
projects/*/src_video/
projects/*/dm-pack/
projects/*/cover/
projects/aftercode/assets/
projects/aftercode/web/test-assets/*.jpg
projects/aftercode/web/test-assets/*.png
projects/genie-4/SOURCE/public/frames/

# ---------------------------------------------------------------- third-party material (research, screenshots, stock, other creators' media)
**/references/
app/public/*/screens/
app/public/*/thumbs/
app/public/gh/*.jpg
data/aura*/face.json
/Assets/
kit/*.pdf

# ---------------------------------------------------------------- separate repositories (cloned or published on their own)
/OpenMontage/
/share/
tools/genjutsu/
/skills/

# imported skill packs stay local (they have their own sources and licences); only this repo's own skills are shared
.claude/skills/*
!.claude/skills/reel-pipeline/

# screenshots of third-party sources used as on-screen receipts
**/public/receipts/
app/public/repos/*.jpg
